{
  "name": "@lbryany/dsh-peer",
  "version": "0.4.1",
  "description": "Peer messaging for dsh sessions: same-machine sockets plus Peer Hub (central) for remote peers",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "peer",
    "multi-agent"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/hub.md",
    "docs/hub.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "@lbryany/peer-hub-client": ">=0.4.0 <0.5.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@lbryany/peer-hub-client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "link-dsh": "node scripts/link-dsh.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "test:hub": "node scripts/hub-check.mjs",
    "test:mixed": "node scripts/mixed-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:reply-browser": "node scripts/reply-browser-check.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lbryany/dsh-plugins.git",
    "directory": "packages/dsh-peer"
  },
  "bugs": {
    "url": "https://github.com/Lbryany/dsh-plugins/issues"
  },
  "homepage": "https://github.com/Lbryany/dsh-plugins/tree/main/packages/dsh-peer#readme",
  "devDependencies": {
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@lbryany/peer-hub-client": "file:../../../peer-hub/packages/client"
  }
}
