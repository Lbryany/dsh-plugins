{
  "name": "@lbryany/dsh-compaction-instruction",
  "version": "0.2.0",
  "description": "Drop-in replacement for dsh-compaction-basic whose summarization directive a profile can append to or replace, with an extension point for appending sections after the summary",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "summarization"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "link-dsh": "node scripts/link-dsh.mjs",
    "test": "node scripts/link-dsh.mjs && node --test test/*.test.mjs",
    "check": "npm test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lbryany/dsh-plugins.git",
    "directory": "packages/dsh-compaction-instruction"
  },
  "bugs": {
    "url": "https://github.com/Lbryany/dsh-plugins/issues"
  },
  "homepage": "https://github.com/Lbryany/dsh-plugins/tree/main/packages/dsh-compaction-instruction#readme",
  "compactionSections": {
    "event": "compaction-instruction/sections",
    "version": 1
  }
}
